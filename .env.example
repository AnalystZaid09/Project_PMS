# Database Configuration
POSTGRES_DB=pms_db
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=pms_secure_password_replace_in_prod
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pms_user:pms_secure_password_replace_in_prod@localhost:5432/pms_db

# Security & Tokens
SECRET_KEY=antigravity_pms_super_secret_jwt_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment & Network
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
BACKEND_PORT=8000
FRONTEND_PORT=3000

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

